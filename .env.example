# --- Database (Postgres via Supabase in production; local Postgres in dev/sandbox) ---
# Runtime connection: a non-owner role so RLS actually applies (see DECISIONS.md).
DATABASE_URL=postgres://keepbooks_app:keepbooks_app_dev_pw@localhost:5432/keepbooks
# Migration connection: the schema-owning role. Used only by db:generate/db:migrate/seed.
MIGRATION_DATABASE_URL=postgres://keepbooks:keepbooks_dev_pw@localhost:5432/keepbooks

# --- Supabase (production target — not used by the sandbox dev auth shim, see DECISIONS.md) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth session ---
# Random 32+ byte secret used to sign session cookies (dev auth shim, see DECISIONS.md)
AUTH_SECRET=change-me-to-a-long-random-string-in-production

# --- App base URL (used to build absolute links in emails, e.g. password reset) ---
APP_URL=http://localhost:3000

# --- AI extraction (Phase 2, not used in Phase 0/1) ---
ANTHROPIC_API_KEY=

# --- Supabase Storage (Phase 2, not used in Phase 0/1) ---
SUPABASE_STORAGE_BUCKET=source-documents

# --- PDF generation (loose-leaf books, spec §3) ---
# Only needed if your host has a pre-fetched Chromium whose revision doesn't
# match this project's installed `playwright` version. Leave unset normally.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
